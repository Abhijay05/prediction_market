{
  "name": "lvramm-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":          "tsx watch src/api/index.ts",
    "dev:worker":   "tsx watch src/queue/index.ts",
    "build":        "tsc",
    "start":        "node dist/api/index.js",
    "start:worker": "node dist/queue/index.js",
    "db:migrate":   "prisma migrate dev",
    "db:generate":  "prisma generate",
    "db:studio":    "prisma studio",
    "test":         "jest --runInBand",
    "test:watch":   "jest --watch"
  },
  "dependencies": {
    "@prisma/client":      "^5.14.0",
    "alchemy-sdk":         "^3.3.4",
    "bullmq":              "^5.7.0",
    "cors":                "^2.8.5",
    "ethers":              "^6.12.0",
    "express":             "^4.19.2",
    "helmet":              "^7.1.0",
    "ioredis":             "^5.3.2",
    "jsonwebtoken":        "^9.0.2",
    "pino":                "^9.1.0",
    "prom-client":         "^15.1.3",
    "siwe":                "^2.3.2",
    "ws":                  "^8.17.0",
    "zod":                 "^3.23.8"
  },
  "devDependencies": {
    "@types/cors":         "^2.8.17",
    "@types/express":      "^4.17.21",
    "@types/jest":         "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node":         "^20.12.12",
    "@types/supertest":    "^6.0.2",
    "@types/ws":           "^8.5.10",
    "jest":                "^29.7.0",
    "pino-pretty":         "^11.0.0",
    "prisma":              "^5.14.0",
    "supertest":           "^7.0.0",
    "ts-jest":             "^29.1.4",
    "tsx":                 "^4.11.0",
    "typescript":          "^5.4.5"
  },
  "jest": {
    "preset":              "ts-jest",
    "testEnvironment":     "node",
    "testMatch":           ["**/tests/**/*.test.ts"],
    "setupFiles":          ["<rootDir>/tests/setup.ts"]
  }
}