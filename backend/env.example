# backend/.env.example

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lvramm"

# Redis
REDIS_URL="redis://localhost:6379"

# Alchemy (free tier — sign up at alchemy.com, create a Sepolia app)
ALCHEMY_API_KEY="your_alchemy_api_key_here"

# Contract addresses (from your Foundry deployment)
ROUTER_ADDRESS="0xYourRouterContractAddress"

# Auth
JWT_SECRET="change_me_in_production_min_32_chars"

# Server
PORT=3001
FRONTEND_URL="http://localhost:5173"
LOG_LEVEL="info"
NODE_ENV="development"
